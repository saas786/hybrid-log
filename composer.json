{
	"name": "themehybrid/hybrid-log",
	"description": "Log package for the Hybrid Core framework.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress"
	],
	"authors": [
		{
			"name": "Theme Hybrid",
			"email": "themehybrid@gmail.com",
			"homepage": "https://themehybrid.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/themehybrid/hybrid-log",
	"support": {
		"issues": "https://github.com/themehybrid/hybrid-log/issues",
		"forum": "https://themehybrid.com/board/forums/hybrid-core"
	},
	"require": {
		"php": ">=8.2",
		"monolog/monolog": "^3.0",
		"psr/log": "^1.0 || ^2.0 || ^3.0"
	},
	"require-dev": {
		"alvarodelera/pest-wp-plugin": "^2.0",
		"pestphp/pest": "^5.0",
		"themehybrid/hybrid-contracts": "^2.0",
		"themehybrid/hybrid-tools": "^2.0"
	},
	"provide": {
		"psr/log-implementation": "1.0 || 2.0 || 3.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Hybrid\\Log\\": "src/"
		},
		"files": [
			"src/functions-helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Hybrid\\Log\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"scripts": {
		"test": "pest"
	}
}
